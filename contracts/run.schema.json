{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aixaria.dev/chimera-one/run/v1",
  "title": "Chimera Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "objective",
    "domain",
    "policy",
    "steps",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "chimera-run/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "general",
        "rchain-audit"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_mutation",
        "automatic_deployment",
        "unrestricted_execution",
        "claim_promotion_requires_evidence"
      ],
      "properties": {
        "automatic_mutation": {
          "const": false
        },
        "automatic_deployment": {
          "const": false
        },
        "unrestricted_execution": {
          "const": false
        },
        "claim_promotion_requires_evidence": {
          "const": true
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "provider",
          "kind",
          "depends_on",
          "trust",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "reason",
              "plan",
              "simulate",
              "execute",
              "observe",
              "verify",
              "attest",
              "audit"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "trust": {
            "type": "object"
          },
          "state": {
            "enum": [
              "PLANNED",
              "RUNNING",
              "COMPLETE",
              "BLOCKED",
              "FAILED"
            ]
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "HYPOTHESIS",
              "PLAUSIBLE",
              "OBSERVED",
              "REPRODUCED",
              "CORROBORATED",
              "VERIFIED_WITHIN_SCOPE",
              "CONTRADICTED",
              "INCONCLUSIVE",
              "UNKNOWN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
