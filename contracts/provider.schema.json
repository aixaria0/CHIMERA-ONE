{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aixaria.dev/chimera-one/provider/v1",
  "title": "Chimera Provider v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "role",
    "control_plane",
    "version",
    "entrypoints",
    "boundaries"
  ],
  "properties": {
    "schema": {
      "const": "chimera-provider/v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "control_plane": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "mode",
          "network",
          "mutation"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "enum": [
              "advisory",
              "bounded-execution",
              "verification",
              "audit"
            ]
          },
          "network": {
            "enum": [
              "none",
              "loopback",
              "explicit"
            ]
          },
          "mutation": {
            "enum": [
              "none",
              "workspace",
              "external-explicit"
            ]
          },
          "transport": {
            "enum": [
              "http",
              "grpc",
              "stdio",
              "jsonl"
            ]
          },
          "endpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol"
            ],
            "properties": {
              "protocol": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "health_path": {
                "type": "string",
                "minLength": 1
              },
              "service": {
                "type": "string",
                "minLength": 1
              },
              "rpc": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "command"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "transport"
                  ]
                },
                {
                  "required": [
                    "endpoint"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "transport",
              "endpoint"
            ],
            "not": {
              "required": [
                "command"
              ]
            }
          }
        ]
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
